{
  "name": "coachbower",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "node _build/build.cjs public https://coachbower.com"
  },
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "worker/index.mjs",
  "d1_databases": [
    {
      "binding": "SITE_DB",
      "database_name": "coachbower-admin",
      "database_id": "659e7d4d-9df3-4d11-b90d-e34c1eae561a"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "coachbower-admin.cloudflareaccess.com",
    "ACCESS_AUD": "470fe950167e30bc35fcf17f2196e8bc4b2646c3d9633988568eb76add339a80",
    "CLIENT_ACCESS_AUD": "00322ee84e368bfc1348c81165e0e22f6d30647b3ae0da86ae62a3e48866202b"
  }
}
